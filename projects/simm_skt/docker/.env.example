# ==============================================================================
# Variables de Entorno - simm_skt (Docker)
# ==============================================================================

# Configuración de Rutas
PROJECT_ROOT=C:/Users/rinco/simm_skt

# Almacenamiento PostgreSQL:
# Se recomienda usar el volumen 'AdmsimPostgresData' (con Docker Desktop apuntando a K:).
# Los volúmenes nombrados evitan problemas de permisos NTFS con PostgreSQL.
DB_DATA_PATH=AdmsimPostgresData

# Puertos (para evitar colisiones)
APP_PORT=8083
DB_PORT=5435
POSTGRES_PASSWORD=postgres