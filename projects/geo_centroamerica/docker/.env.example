# ==============================================================================
# Variables de Entorno - geo_centroamerica (PostgreSQL 16 + PostGIS + H3)
# ==============================================================================

# Puerto de PostgreSQL
DB_PORT=5434

# Credenciales de Base de Datos
POSTGRES_DB=osm_centroamerica
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword

# Ruta a la carpeta con los archivos pesados (.osm.pbf de OpenStreetMap)
# Por defecto usa ./data local. Para ahorrar espacio en C:, apúntalo a tu disco externo K:
# Ejemplo: K:/geo_centroamerica/data
GEO_DATA_PATH=./data
