# ==============================================================================
# Variables de Entorno - tobo4_Backend
# Copia este archivo como .env en esta misma carpeta y ajusta los valores si es necesario
# ==============================================================================

# PostgreSQL / Citus
DB_PORT=5432
POSTGRES_DB=tobodb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=bigBleu5

# Ruta al directorio de backups/dumps en disco externo K:
# Si usas Windows, puedes usar K:/citus_data/backup
BACKUP_DIR=K:/citus_data/backup

# Redis
REDIS_PORT=6379

# RabbitMQ
RABBIT_PORT=5672
RABBIT_MGMT_PORT=15672

# WebSocket TCP Relay
TCP_RELAY_PORT=15670
