# ==============================================================================
# Variables de Entorno - Moodle Migration (Docker)
# Copia este archivo a .env y ajusta los valores según tu máquina
# ==============================================================================

# Puertos expuestos en el Host
WEB_PORT=8080
DB_PORT=33066

# Credenciales MySQL (Línea Base 5.5)
MYSQL_ROOT_PASSWORD=moodle_root_pass
MYSQL_DATABASE=moodle
MYSQL_USER=moodleuser
MYSQL_PASSWORD=moodle_pass

# Configuración Moodle
MOODLE_URL=http://localhost:8080

# Rutas relativas de datos locales (ignoradas en git)
PATH_MOODLEDATA=./data/moodledata
PATH_MOODLESRC=./data/moodle_src
PATH_SQL_INIT=./data/sql
