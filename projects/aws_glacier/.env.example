# ==============================================================================
# Variables de Entorno - AWS S3 Glacier Cleanup
# ==============================================================================
# Copia este archivo a .env y completa tus datos:
#   cp .env.example .env

# Región de AWS donde se encuentra el Vault (ej. us-east-1, us-west-2)
AWS_REGION=us-east-1

# Nombre del Vault de S3 Glacier
GLACIER_VAULT=mi_vault_glacier

# Opción A: Perfil de AWS CLI configurado en ~/.aws/credentials (dejar vacío si usas Access Keys abajo)
AWS_PROFILE=

# Opción B: Credenciales directas de IAM (si no usas AWS_PROFILE)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Último Job ID generado por el comando 'init' (opcional, para no pasarlo por parámetro cada vez)
GLACIER_JOB_ID=

# Cantidad de hilos simultáneos para eliminar archivos
GLACIER_WORKERS=15
